# ─── Revamp Consulting LLC — Environment Variables ────────────────────────────
#
# Copy this file to .env.local (git-ignored) and fill in your values.
# Never commit real keys or webhook URLs to version control.
#
# ─── HubSpot CRM (Primary Lead Capture) ──────────────────────────────────────
#
# Portal ID and Form GUID from HubSpot:
#   1. Portal ID can be found in your HubSpot account URL or settings.
#   2. Form GUID can be found in the embed code of your HubSpot form.
#
# Custom properties to create in HubSpot (Settings → Properties → Contact):
#   • service_interested_in  (Single-line text or Dropdown)
#   • business_challenge     (Multi-line text)
#
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_GUID=

# ─── Resend (Email Delivery) ──────────────────────────────────────────────────
#
# Server-side only — do NOT prefix with VITE_. Get key from https://resend.com
# Also set this in your Vercel project's Environment Variables (Production + Preview).
# The "from" address in api/send-email.js must be on a domain verified in Resend.
RESEND_API_KEY=

# ─── Lead Form Endpoint (Webhook Fallback) ───────────────────────────────────
#
# Point VITE_LEAD_FORM_ENDPOINT at any of the following:
#   • Airtable automation webhook:
#       https://hooks.airtable.com/workflows/v1/<TOKEN>/...
#   • Make (Integromat) webhook:
#       https://hook.eu1.make.com/<TOKEN>
#   • Zapier webhook:
#       https://hooks.zapier.com/hooks/catch/<ID>/<TOKEN>/
#   • Your own backend API route:
#       https://api.revampconsult.com/leads
#
# Leave blank to run in dev-log mode (payloads printed to browser console).
VITE_LEAD_FORM_ENDPOINT=
